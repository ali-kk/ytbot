# Telegram bot token from @BotFather. Secret: never commit or share it.
BOT_TOKEN=

# How the bot reaches YouTube: comma-separated routes, used in rotation.
# A route is a proxy URL (socks5://... or http://...) or the word "direct" (the server's own IP).
# Default: Cloudflare WARP (README step 7), then the server's own IP.
# For lots of users, add residential proxies in front (README "Handling lots of users").
YT_PROXY=socks5://127.0.0.1:40000,direct
